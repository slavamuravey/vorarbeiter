{
  "compilerOptions": {
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "lib": [
      "esnext"
    ],
    "alwaysStrict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "newLine": "lf",
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "example"
  ]
}